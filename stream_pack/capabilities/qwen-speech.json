    "reference_audio": {
      "node": "1",
      "input": "reference_audio"
    },
    "reference_text": {
      "node": "1",
      "input": "reference_text"
    },
    "language": {
      "node": "1",
      "input": "language"
    }
  },
  "output_binding": {
    "node": "2",
    "key": "service_result"

{
  "version": 1,
  "id": "ace-music",
  "description": "Generate music from a description and lyrics",
  "model": {
    "source": "ACE-Step/Ace-Step1.5",
    "revision": "19671f406d603126926c1b7e2adc169acbcade22",
    "license": "mit"
  },
  "operation": "music_generations",
  "modes": [
    "job",
    "sync"
  ],
  "admission": "candidate",
  "dependency_group": "media",
  "input_schema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "lyrics": {
        "type": "string",
        "default": ""
